# Compile pins for scripts/dev.sh. Copy to configs/build.env (gitignored); dev.sh
# sources it when present. A path or SM change is a one-line edit here.

# Unique build slot directories live under this root. target/ is gitignored.
export MIMO26F_BUILD_ROOT="${ROOT:-$PWD}/target/mimo26f-builds"
# A filesystem that must never hold a build root (empty: none).
MIMO26F_SCRATCH_FORBIDDEN=

# The Rust toolchain for non-login shells.
export PATH="${HOME}/.cargo/bin:${PATH}"

# SM pins. `doctor` prints the live value; `bake` refuses a mismatch. Rebuild, don't patch.
# 170 = RTX 5090 (SM count, as DS41RT names it). 120 / 120a = RTX PRO 6000 class. 121 = GB10 (DGX Spark).
MIMO26F_SM_COORDINATOR_5090=170
MIMO26F_SM_RTXPRO=120
MIMO26F_SM_SPARK=121
